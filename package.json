{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/check-bundle-size.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "architecture": "dependency-cruiser --config .dependency-cruiser.cjs src",
    "knip": "knip",
    "quality": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm architecture && pnpm knip && pnpm build"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.25.0",
    "knip": "^6.32.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "6.2.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@google/genai@2.16.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
